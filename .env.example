# ==============================================================================
# AI Incident & Operations Management Platform - Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000

# MongoDB Configuration
# In Docker: mongodb://mongodb:27017/incident_platform
# Standalone local: mongodb://localhost:27017/incident_platform
MONGODB_URI=mongodb://localhost:27017/incident_platform

# Redis Configuration
# In Docker: redis
# Standalone local: localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=dev-jwt-secret-incident-platform-minimum-32-chars-long
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-incident-platform-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# AI / OpenRouter Configuration (Optional: App runs gracefully without AI key)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

